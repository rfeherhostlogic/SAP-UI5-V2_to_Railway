<mvc:View
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:unified="sap.ui.unified"
  controllerName="sap.suite.ui.commons.demo.tutorial.controller.Discovery">
  <Page id="discoveryPage" showHeader="false" class="discoveryPage">
    <content>
      <VBox class="discoveryShell sapUiMediumMargin">
        <VBox visible="{= ${discovery>/entryMode} === 'launcher' }" class="discoveryLauncher">
          <VBox class="sapUiSmallMarginBottom">
            <Title text="Felfedezes" level="H2"/>
            <Text text="Valassz egy iranyt: AI-alapu otletgyujtes, klasszikus ML trening vagy strukturalt AI modell." class="sapUiTinyMarginTop mlWizardSubtitle"/>
          </VBox>

          <HBox justifyContent="Center" class="discoveryLauncherRow discoveryLauncherRowSingle">
            <GenericTile header="1. Felfedezes" subheader="AI altal javasolt uzleti lehetosegek" press=".onOpenDiscoveryAdvisor" class="discoveryLauncherTile discoveryLauncherTileHero">
              <tileContent>
                <TileContent footer="Uzleti dontestamogato javaslatok">
                  <content>
                    <NumericContent icon="sap-icon://lightbulb" indicator="Up" value="AI"/>
                  </content>
                </TileContent>
              </tileContent>
            </GenericTile>
          </HBox>

          <HBox justifyContent="Center" wrap="Wrap" class="discoveryLauncherRow">
            <GenericTile header="2. Klasszikus ML trening" subheader="A jelenlegi wizard teljes folyamata" press=".onOpenDiscoveryClassic" class="discoveryLauncherTile">
              <tileContent>
                <TileContent footer="Altalanos ML modellezes">
                  <content>
                    <NumericContent icon="sap-icon://machine" indicator="Up" value="ML"/>
                  </content>
                </TileContent>
              </tileContent>
            </GenericTile>

            <GenericTile header="3. Strukturalt AI modell (RPT1)" subheader="Altalanos CSV predikcio [PREDICT] mezokre" press=".onOpenDiscoveryStructured" class="discoveryLauncherTile">
              <tileContent>
                <TileContent footer="Strukturalt sor-szintu modell">
                  <content>
                    <NumericContent icon="sap-icon://ai" indicator="Up" value="RPT1"/>
                  </content>
                </TileContent>
              </tileContent>
            </GenericTile>
          </HBox>
        </VBox>

        <VBox visible="{= ${discovery>/entryMode} === 'advisor' }" class="discoveryAdvisorShell">
          <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom">
            <VBox>
              <Title text="AI Felfedezes" level="H2"/>
              <Text text="Az elerheto adatforrasok alapjan javaslatokat kapsz arra, milyen uzleti problemakat erdemes AI-jal megoldani." class="sapUiTinyMarginTop mlWizardSubtitle"/>
            </VBox>
            <Button text="Vissza a csempekhez" icon="sap-icon://nav-back" type="Transparent" press=".onBackToDiscoveryLauncher"/>
          </HBox>

          <MessageStrip text="{discovery>/advisorSummary}" type="Information" showCloseButton="false" visible="{= !!${discovery>/advisorSummary} }" class="sapUiSmallMarginBottom"/>

          <Panel headerText="Jelenleg elerheto adatforrasok" class="discoveryAdvisorPanel sapUiSmallMarginBottom">
            <List items="{discovery>/advisorAvailableSources}" noDataText="Nem sikerult adatforrast beolvasni.">
              <CustomListItem>
                <HBox alignItems="Center" class="sapUiSmallMarginBegin sapUiTinyMarginTopBottom">
                  <core:Icon src="sap-icon://database" color="#0854a0" class="sapUiTinyMarginEnd"/>
                  <Text text="{discovery>}"/>
                </HBox>
              </CustomListItem>
            </List>
          </Panel>

          <VBox visible="{discovery>/advisorBusy}" class="mlWizardCenteredBox">
            <BusyIndicator size="3rem"/>
            <Text text="AI javaslatok keszulnek..." class="sapUiSmallMarginTop"/>
          </VBox>

          <FlexBox wrap="Wrap" justifyContent="Center" class="discoveryAdvisorGrid" visible="{= !${discovery>/advisorBusy} }" items="{discovery>/advisorSuggestions}">
            <items>
              <Panel headerText="{discovery>problemType}" class="discoveryAdvisorCard">
                <VBox class="sapUiSmallMargin">
                  <Title text="{discovery>title}" level="H4"/>
                  <Text text="{discovery>rationale}" wrapping="true" class="sapUiTinyMarginTop"/>
                  <MessageStrip
                    text="{= 'Javasolt modell: ' + ${discovery>modelTitle} + ' - ' + ${discovery>modelDescription} }"
                    type="Success"
                    showCloseButton="false"
                    class="sapUiSmallMarginTop"/>
                  <List items="{discovery>featureHints}" noDataText="" visible="{= ${discovery>featureHints}.length > 0 }" class="sapUiSmallMarginTop">
                    <CustomListItem>
                      <HBox alignItems="Center">
                        <core:Icon src="sap-icon://hint" color="#e78c07" class="sapUiTinyMarginEnd"/>
                        <Text text="{discovery>}"/>
                      </HBox>
                    </CustomListItem>
                  </List>
                  <Button text="Inditas" icon="sap-icon://arrow-right" type="Emphasized" press=".onSelectAdvisorSuggestion" class="sapUiSmallMarginTop"/>
                </VBox>
              </Panel>
            </items>
          </FlexBox>
        </VBox>

        <VBox visible="{= ${discovery>/entryMode} === 'structured' }" class="discoveryStructuredShell">
          <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom">
            <VBox>
              <Title text="Strukturalt AI modell (RPT1)" level="H2"/>
              <Text text="Tolts fel barmilyen CSV-t, ahol a prediklando mezok [PREDICT] ertekkel vannak jelolve." class="sapUiTinyMarginTop mlWizardSubtitle"/>
            </VBox>
            <Button text="Vissza a csempekhez" icon="sap-icon://nav-back" type="Transparent" press=".onBackToDiscoveryLauncher"/>
          </HBox>

          <Panel headerText="CSV feltoltes es futtatas" class="discoveryStructuredPanel sapUiSmallMarginBottom">
            <VBox class="sapUiSmallMargin">
              <unified:FileUploader
                id="structuredAiUploader"
                fileType="csv"
                uploadOnChange="false"
                multiple="false"
                change=".onStructuredAiFileSelected"
                placeholder="Valassz CSV fajlt"
                width="100%"
                style="Emphasized"/>
              <Text text="{= ${discovery>/structuredAiFileName} ? 'Kivalasztott fajl: ' + ${discovery>/structuredAiFileName} : '' }" visible="{= !!${discovery>/structuredAiFileName} }" class="sapUiSmallMarginTop"/>
              <HBox class="sapUiSmallMarginTop">
                <Button text="Predikcio futtatasa" icon="sap-icon://play" type="Emphasized" press=".onRunStructuredAiPrediction" busy="{discovery>/structuredAiBusy}"/>
              </HBox>
            </VBox>
          </Panel>

          <MessageStrip text="{discovery>/structuredAiSummary}" type="Information" showCloseButton="false" visible="{= !!${discovery>/structuredAiSummary} }" class="sapUiSmallMarginBottom"/>
          <MessageStrip text="{discovery>/structuredAiError}" type="Error" showCloseButton="false" visible="{= !!${discovery>/structuredAiError} }" class="sapUiSmallMarginBottom"/>

          <Panel headerText="Predikcios metrikak" class="discoveryStructuredPanel sapUiSmallMarginBottom" visible="{= !!${discovery>/structuredAiMetrics} }">
            <VBox class="sapUiSmallMargin">
              <Text text="{= 'Query sorok: ' + ${discovery>/structuredAiMetrics/queryCount} + ', context sorok: ' + ${discovery>/structuredAiMetrics/contextCount} + ', API hivasok: ' + ${discovery>/structuredAiMetrics/apiCalls} }"/>
              <List items="{discovery>/structuredAiMetrics/predictColumns}" noDataText="" class="sapUiSmallMarginTop">
                <CustomListItem>
                  <HBox alignItems="Center">
                    <core:Icon src="sap-icon://ai" color="#0854a0" class="sapUiTinyMarginEnd"/>
                    <Text text="{discovery>}"/>
                  </HBox>
                </CustomListItem>
              </List>
            </VBox>
          </Panel>

          <Panel headerText="Predikcios eredmenyek" class="discoveryStructuredPanel sapUiSmallMarginBottom" visible="{= ${discovery>/structuredAiPredictionRows}.length > 0 }">
            <Table id="structuredPredictionTable" fixedLayout="false" growing="true" growingThreshold="100"/>
          </Panel>

          <Panel headerText="Felismert cashflow aggregacio" class="discoveryStructuredPanel" visible="{= ${discovery>/structuredAiChartRows}.length > 0 }">
            <List items="{discovery>/structuredAiChartRows}" noDataText="">
              <CustomListItem>
                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBegin sapUiTinyMarginTopBottom sapUiSmallMarginEnd">
                  <Text text="{discovery>monthLabel}" class="mlWizardBold"/>
                  <Text text="{discovery>predictedCashflowFormatted}"/>
                </HBox>
              </CustomListItem>
            </List>
          </Panel>
        </VBox>

        <VBox visible="{= ${discovery>/entryMode} === 'classic' }">
          <HBox justifyContent="End" class="sapUiSmallMarginBottom">
            <Button text="Vissza a csempekhez" icon="sap-icon://nav-back" type="Transparent" press=".onBackToDiscoveryLauncher"/>
          </HBox>
          <mvc:XMLView id="classicMlWizardView" viewName="sap.suite.ui.commons.demo.tutorial.view.MLWizard"/>
        </VBox>
      </VBox>
    </content>
  </Page>
</mvc:View>
