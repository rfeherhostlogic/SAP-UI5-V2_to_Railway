<mvc:View
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:tnt="sap.tnt"
  controllerName="sap.suite.ui.commons.demo.tutorial.controller.Main">
  <tnt:ToolPage id="toolPage" sideExpanded="{app>/sideNavExpanded}">
    <tnt:header>
      <tnt:ToolHeader>
        <Button icon="sap-icon://menu2" type="Transparent" press=".onToggleSideNav"/>
        <HBox alignItems="Center">
          <Image src="img/techGPT.png" height="2rem" decorative="false" alt="TechGPT logo"/>
          <Title text="HelloAI Portal" class="sapUiTinyMarginBegin"/>
        </HBox>
        <ToolbarSpacer/>
        <Text text="{= ${app>/userName} ? 'Bejelentkezve: ' + ${app>/userName} : '' }"/>
        <Button text="Kijelentkezes" type="Transparent" press=".onLogout"/>
      </tnt:ToolHeader>
    </tnt:header>
    <tnt:sideContent>
      <tnt:SideNavigation selectedKey="{app>/selectedMenuKey}" itemSelect=".onItemSelect" expanded="{app>/sideNavExpanded}">
        <tnt:item>
          <tnt:NavigationList>
            <tnt:NavigationListItem text="Noah" key="noah" icon="sap-icon://collaborate"/>
            <tnt:NavigationListItem text="Hirfolyam" key="feed" icon="sap-icon://discussion-2"/>
            <tnt:NavigationListItem text="Jokerek" key="jokers" icon="sap-icon://favorite"/>
            <tnt:NavigationListItem text="Flow" key="flow" icon="sap-icon://process"/>
            <tnt:NavigationListItem text="Felfedezes" key="discovery" icon="sap-icon://search"/>
          </tnt:NavigationList>
        </tnt:item>
        <tnt:fixedItem>
          <tnt:NavigationList>
            <tnt:NavigationListItem text="Pajzs" key="reports" icon="sap-icon://shield"/>
          </tnt:NavigationList>
        </tnt:fixedItem>
      </tnt:SideNavigation>
    </tnt:sideContent>
    <tnt:mainContents>
      <NavContainer id="mainNav">
        <mvc:XMLView id="reportsView" viewName="sap.suite.ui.commons.demo.tutorial.view.Reports"/>
        <mvc:XMLView id="jokersView" viewName="sap.suite.ui.commons.demo.tutorial.view.Jokers"/>
        <mvc:XMLView id="flowView" viewName="sap.suite.ui.commons.demo.tutorial.view.Flow"/>
        <mvc:XMLView id="discoveryView" viewName="sap.suite.ui.commons.demo.tutorial.view.Discovery"/>
        <mvc:XMLView id="discoveryClassicView" viewName="sap.suite.ui.commons.demo.tutorial.view.MLWizard"/>
        <mvc:XMLView id="feedView" viewName="sap.suite.ui.commons.demo.tutorial.view.Feed"/>
        <mvc:XMLView id="noah2View" viewName="sap.suite.ui.commons.demo.tutorial.view.Noah2"/>
        <mvc:XMLView id="jokerPromptView" viewName="sap.suite.ui.commons.demo.tutorial.view.JokerPrompt"/>
      </NavContainer>
    </tnt:mainContents>
  </tnt:ToolPage>
</mvc:View>
