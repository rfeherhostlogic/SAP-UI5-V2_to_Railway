<mvc:View
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:unif="sap.ui.unified"
  controllerName="sap.suite.ui.commons.demo.tutorial.controller.Noah2">
  <Page title="Noah" class="sapUiContentPadding noahPage" showHeader="false">
    <HBox class="noahShell" renderType="Bare" wrap="NoWrap">
      <VBox class="noahMain">
        <VBox
          class="noahStartStage"
          visible="{= !${noah2>/hasConversationStarted} }"
          alignItems="Center"
          justifyContent="Center">
          <Title text="Kerdezz a ceged adatairol!" level="H1" class="noahStartTitle"/>

          <List
            items="{noah2>/attachments}"
            visible="{= ${noah2>/attachments}.length > 0 }"
            class="noahAttachmentList noahStartAttachmentList sapUiSmallMarginTop sapUiSmallMarginBottom">
            <CustomListItem>
              <HBox justifyContent="SpaceBetween" alignItems="Center">
                <Text text="{= ${noah2>name} + ' (' + ${noah2>type} + ', ' + ${noah2>size} + ' B)' }" wrapping="false"/>
                <Button icon="sap-icon://decline" type="Transparent" press=".onRemoveAttachment2"/>
              </HBox>
            </CustomListItem>
          </List>

          <HBox class="noahStartComposerWrap" alignItems="Center" justifyContent="Center">
            <VBox class="noahStartComposerStack">
              <HBox class="noahComposerBar noahComposerBarStart" alignItems="Center">
                <Image src="img/Noah_transparent.png" decorative="false" alt="Noah" class="noahStartLogo"/>
                <unif:FileUploader
                  width="2.5rem"
                  sameFilenameAllowed="true"
                  multiple="true"
                  uploadOnChange="false"
                  icon="sap-icon://add-document"
                  iconOnly="true"
                  buttonOnly="true"
                  tooltip="Browse or drop multiple files"
                  change=".onNoah2FileChange"/>
                <TextArea
                  id="noah2DraftInputStart"
                  value="{noah2>/draftMessage}"
                  width="100%"
                  rows="1"
                  growing="true"
                  growingMaxLines="6"
                  placeholder="{= ${noah2>/dictationActive} ? 'Diktalas folyamatban...' : 'Kérdezz bármit' }"
                  class="noahComposerInput noahStartInput">
                  <layoutData>
                    <FlexItemData growFactor="1" shrinkFactor="1"/>
                  </layoutData>
                </TextArea>
                <HBox class="noahComposerUtility" alignItems="Center">
                  <HBox class="noahBusinessToggleWrap" alignItems="Center">
                    <Text text="Uzleti AI" class="noahBusinessToggleLabel"/>
                    <Switch
                      state="{noah2>/businessAiEnabled}"
                      customTextOn="ON"
                      customTextOff="OFF"
                      change=".onBusinessAiToggle"/>
                  </HBox>
                  <Button
                    icon="sap-icon://microphone"
                    type="{= ${noah2>/dictationActive} ? 'Emphasized' : 'Transparent' }"
                    tooltip="{= ${noah2>/dictationSupported} ? 'Dictate' : (${noah2>/dictationUnavailableReason} || 'Dictate nem tamogatott') }"
                    press=".onToggleNoah2Dictation"
                    enabled="{noah2>/dictationSupported}"
                    class="noahUtilityIconButton"/>
                  <Button
                    icon="sap-icon://paper-plane"
                    type="Emphasized"
                    tooltip="Kuldes"
                    press=".onSendNoah2"
                    class="noahSendButton"
                    enabled="{= ${noah2>/state} !== 'ROUTING' &amp;&amp; ${noah2>/state} !== 'RUNNING_CARD' &amp;&amp; ${noah2>/state} !== 'CHATTING' &amp;&amp; !${noah2>/promptImproverBusy} }"/>
                </HBox>
              </HBox>

              <HBox class="noahMenuRow" alignItems="Center" justifyContent="Center" wrap="Wrap">
                <Button text="Flows" icon="sap-icon://combine" type="Transparent" class="noahMenuPill" press=".onOpenNoah2FlowMenu"/>
                <Button text="{noah2>/selectedJokerLabel}" icon="sap-icon://favorite" type="Transparent" class="noahMenuPill" press=".onOpenNoah2JokerMenu"/>
                <Button text="Automatizacio" icon="sap-icon://workflow-tasks" type="Transparent" class="noahMenuPill" press=".onOpenNoah2AutomationMenu"/>
              </HBox>

              <HBox class="noahToolRow" alignItems="Center" justifyContent="Center" wrap="Wrap">
                <Button
                  text="Prompt javito"
                  icon="sap-icon://edit"
                  press=".onImprovePrompt"
                  type="Transparent"
                  class="noahToolPill"
                  enabled="{= ${noah2>/state} !== 'ROUTING' &amp;&amp; ${noah2>/state} !== 'RUNNING_CARD' &amp;&amp; ${noah2>/state} !== 'CHATTING' &amp;&amp; !${noah2>/promptImproverBusy} }"
                  busy="{noah2>/promptImproverBusy}"/>
                <ToggleButton
                  text="Noah agent"
                  icon="sap-icon://activate"
                  pressed="{noah2>/agentEnabled}"
                  press=".onNoah2AgentToggle"
                  type="{= ${noah2>/agentEnabled} ? 'Emphasized' : 'Transparent' }"
                  class="noahToolToggle noahToolPill"/>
              </HBox>
            </VBox>
          </HBox>
        </VBox>

        <VBox class="noahConversationStage" visible="{noah2>/hasConversationStarted}">
          <VBox id="noah2ChatPanel" class="noahChatPanel">
            <List id="noah2MessageList" items="{noah2>/messages}" showSeparators="None" class="noahMsgList">
              <CustomListItem>
                <VBox width="100%">
                  <HBox width="100%" justifyContent="Start" visible="{= ${noah2>role} !== 'user' }">
                    <Avatar src="img/Noah_transparent.png" displaySize="XS" class="chatAvatar noahAvatar"/>
                    <VBox class="noahAnswerBlock">
                      <VBox class="chatBubble chatBubbleAi noahBubbleAi">
                        <Text text="Noah" class="chatBubbleMeta"/>
                        <Text text="{noah2>content}" wrapping="true" width="100%" visible="{= !${noah2>messageType} }"/>
                        <VBox visible="{= !!${noah2>messageType} }" width="100%">
                          <Text text="{= '[' + (${noah2>title} || 'AI') + ']' }" class="chatBubbleMeta"/>
                          <Text text="{= ${noah2>content} ? 'Osszegzes:\n' + ${noah2>content} : 'Osszegzes nem elerheto.' }" wrapping="true" class="sapUiTinyMarginTop sapUiTinyMarginBottom"/>
                          <Text text="{= ${noah2>selectedSource} ? 'Forras: ' + ${noah2>selectedSource} : '' }" visible="{= !!${noah2>selectedSource} }" wrapping="true" class="sapUiTinyMarginBottom"/>
                          <Text text="Chart nem elerheto." visible="{= !${noah2>chartAvailable} }" wrapping="true" class="sapUiTinyMarginBottom"/>
                          <core:HTML content="{noah2>chartHtml}" visible="{= !!${noah2>chartHtml} }"/>
                          <core:HTML content="{noah2>previewHtml}" visible="{= !!${noah2>previewHtml} }"/>
                        </VBox>
                      </VBox>
                      <HBox class="noahMessageActions" alignItems="Center" wrap="Wrap">
                        <Button icon="sap-icon://copy" type="Transparent" tooltip="Masolas" press=".onCopyNoah2Message"/>
                        <Button
                          icon="sap-icon://thumb-up"
                          type="{= ${noah2>feedback} === 'like' ? 'Emphasized' : 'Transparent' }"
                          tooltip="Tetszik"
                          press=".onLikeNoah2Message"/>
                        <Button
                          icon="sap-icon://thumb-down"
                          type="{= ${noah2>feedback} === 'dislike' ? 'Emphasized' : 'Transparent' }"
                          tooltip="Nem tetszik"
                          press=".onDislikeNoah2Message"/>
                        <Button
                          icon="sap-icon://hint"
                          type="{= ${noah2>infoOpen} ? 'Emphasized' : 'Transparent' }"
                          tooltip="Insight panel"
                          press=".onToggleNoah2MessageInfo"/>
                      </HBox>
                    </VBox>
                  </HBox>
                  <HBox width="100%" justifyContent="End" visible="{= ${noah2>role} === 'user' }">
                    <VBox class="chatBubble chatBubbleUser noahBubbleUser">
                      <Text text="{noah2>content}" wrapping="true" width="100%"/>
                    </VBox>
                  </HBox>
                </VBox>
              </CustomListItem>
            </List>
          </VBox>

          <Button
            text="Ugras az aljara"
            icon="sap-icon://navigation-down-arrow"
            type="Emphasized"
            visible="{noah2>/showScrollToBottom}"
            press=".onNoah2ScrollToBottom"
            class="noahScrollToBottom"/>

          <HBox class="noahMenuRow noahConversationMenuRow" alignItems="Center" justifyContent="Center" wrap="Wrap">
            <Button text="Flows" icon="sap-icon://combine" type="Transparent" class="noahMenuPill" press=".onOpenNoah2FlowMenu"/>
            <Button text="{noah2>/selectedJokerLabel}" icon="sap-icon://favorite" type="Transparent" class="noahMenuPill" press=".onOpenNoah2JokerMenu"/>
            <Button text="Automatizacio" icon="sap-icon://workflow-tasks" type="Transparent" class="noahMenuPill" press=".onOpenNoah2AutomationMenu"/>
          </HBox>

          <HBox class="noahToolRow noahConversationToolRow" alignItems="Center" justifyContent="Center" wrap="Wrap">
            <Button
              text="Prompt javito"
              icon="sap-icon://edit"
              press=".onImprovePrompt"
              type="Transparent"
              class="noahToolPill"
              enabled="{= ${noah2>/state} !== 'ROUTING' &amp;&amp; ${noah2>/state} !== 'RUNNING_CARD' &amp;&amp; ${noah2>/state} !== 'CHATTING' &amp;&amp; !${noah2>/promptImproverBusy} }"
              busy="{noah2>/promptImproverBusy}"/>
            <ToggleButton
              text="Noah agent"
              icon="sap-icon://activate"
              pressed="{noah2>/agentEnabled}"
              press=".onNoah2AgentToggle"
              type="{= ${noah2>/agentEnabled} ? 'Emphasized' : 'Transparent' }"
              class="noahToolToggle noahToolPill"/>
          </HBox>

          <VBox class="noahComposer noahComposerSticky">
            <List
              items="{noah2>/attachments}"
              visible="{= ${noah2>/attachments}.length > 0 }"
              class="noahAttachmentList sapUiTinyMarginBottom">
              <CustomListItem>
                <HBox justifyContent="SpaceBetween" alignItems="Center">
                  <Text text="{= ${noah2>name} + ' (' + ${noah2>type} + ', ' + ${noah2>size} + ' B)' }" wrapping="false"/>
                  <Button icon="sap-icon://decline" type="Transparent" press=".onRemoveAttachment2"/>
                </HBox>
              </CustomListItem>
            </List>

            <HBox class="noahComposerBar noahComposerBarChat" alignItems="End">
              <unif:FileUploader
                id="noah2FileUploader"
                width="2.5rem"
                sameFilenameAllowed="true"
                multiple="true"
                uploadOnChange="false"
                icon="sap-icon://add-document"
                iconOnly="true"
                buttonOnly="true"
                tooltip="Browse or drop multiple files"
                change=".onNoah2FileChange"/>
              <TextArea
                id="noah2DraftInputChat"
                value="{noah2>/draftMessage}"
                width="100%"
                rows="1"
                growing="true"
                growingMaxLines="6"
                placeholder="{= ${noah2>/dictationActive} ? 'Diktalas folyamatban...' : 'Kérdezz bármit' }"
                class="noahComposerInput"/>
              <HBox class="noahComposerUtility" alignItems="Center">
                <HBox class="noahBusinessToggleWrap" alignItems="Center">
                  <Text text="Uzleti AI" class="noahBusinessToggleLabel"/>
                  <Switch
                    state="{noah2>/businessAiEnabled}"
                    customTextOn="ON"
                    customTextOff="OFF"
                    change=".onBusinessAiToggle"/>
                </HBox>
                <Button
                  icon="sap-icon://microphone"
                  type="{= ${noah2>/dictationActive} ? 'Emphasized' : 'Transparent' }"
                  tooltip="{= ${noah2>/dictationSupported} ? 'Dictate' : (${noah2>/dictationUnavailableReason} || 'Dictate nem tamogatott') }"
                  press=".onToggleNoah2Dictation"
                  enabled="{noah2>/dictationSupported}"
                  class="noahUtilityIconButton"/>
                <Button
                  icon="sap-icon://paper-plane"
                  type="Emphasized"
                  tooltip="Kuldes"
                  press=".onSendNoah2"
                  class="noahSendButton"
                  enabled="{= ${noah2>/state} !== 'ROUTING' &amp;&amp; ${noah2>/state} !== 'RUNNING_CARD' &amp;&amp; ${noah2>/state} !== 'CHATTING' &amp;&amp; !${noah2>/promptImproverBusy} }"/>
              </HBox>
            </HBox>

            <Text text="A Noah AI hibazhat. Ellenorizd a valaszokat." class="noahComposerHint"/>
          </VBox>
        </VBox>
      </VBox>

      <VBox class="noahSide" visible="{= ${noah2>/insightsOpen} &amp;&amp; ${noah2>/hasConversationStarted} }">
        <HBox justifyContent="SpaceBetween" alignItems="Center" class="noahInsightsHeader">
          <Title text="Response Insights" level="H3"/>
          <Button text="Close" type="Transparent" press=".onToggleNoah2Insights"/>
        </HBox>

        <Panel
          headerText="Kivalasztott kartya"
          class="noahCardPanel sapUiSmallMarginBottom"
          visible="{= !!${noah2>/activeCard} }">
          <VBox class="noahCardHeader">
            <Title text="{noah2>/activeCard/name}" level="H4"/>
            <Text text="{noah2>/activeCard/description}" wrapping="true"/>
          </VBox>

          <List items="{noah2>/activeCardRuntimeFields}" showSeparators="None">
            <CustomListItem>
              <VBox>
                <HBox justifyContent="SpaceBetween" alignItems="Center">
                  <Label text="{noah2>label}" required="{noah2>required}"/>
                  <Button
                    text="Frissites"
                    icon="sap-icon://refresh"
                    type="Transparent"
                    press=".onRefreshCard2FieldDefault"
                    visible="{= ${noah2>field_id} === 'schema_hint' }"
                    enabled="{= ${noah2>/state} !== 'ROUTING' &amp;&amp; ${noah2>/state} !== 'RUNNING_CARD' &amp;&amp; ${noah2>/state} !== 'CHATTING' }"/>
                </HBox>
                <Input
                  value="{noah2>value}"
                  placeholder="{noah2>placeholder}"
                  visible="{= ${noah2>type} !== 'textarea' &amp;&amp; ${noah2>field_id} !== 'schema_hint' }"
                  enabled="{= ${noah2>/state} !== 'RUNNING_CARD' }"/>
                <TextArea
                  value="{noah2>value}"
                  placeholder="{noah2>placeholder}"
                  rows="3"
                  growing="true"
                  visible="{= ${noah2>type} === 'textarea' &amp;&amp; ${noah2>field_id} !== 'schema_hint' }"
                  enabled="{= ${noah2>/state} !== 'RUNNING_CARD' }"/>
                <Panel
                  headerText="Schema hint"
                  expandable="true"
                  expanded="{noah2>/schemaHintExpanded}"
                  visible="{= ${noah2>field_id} === 'schema_hint' }"
                  class="sapUiTinyMarginTop">
                  <TextArea
                    value="{noah2>value}"
                    placeholder="{noah2>placeholder}"
                    rows="5"
                    growing="true"
                    enabled="{= ${noah2>/state} !== 'RUNNING_CARD' }"/>
                </Panel>
              </VBox>
            </CustomListItem>
          </List>

          <HBox class="sapUiTinyMarginTop" wrap="Wrap">
            <Button
              text="Kartya futtatasa"
              type="Emphasized"
              press=".onRunActiveCard2"
              enabled="{= ${noah2>/state} !== 'RUNNING_CARD' &amp;&amp; ${noah2>/activeCard} ? true : false }"/>
            <Button
              text="Agent lepes folytatasa"
              type="Emphasized"
              press=".onRunActiveCard2"
              class="sapUiTinyMarginBegin"
              visible="{= ${noah2>/agentEnabled} &amp;&amp; ${noah2>/agentEditingStepIndex} >= 0 }"
              enabled="{= ${noah2>/state} !== 'RUNNING_CARD' &amp;&amp; ${noah2>/activeCard} ? true : false }"/>
            <Button
              text="Megerositem"
              type="Accept"
              press=".onConfirmCard2Yes"
              class="sapUiTinyMarginBegin"
              visible="{= ${noah2>/pendingConfirmation} ? true : false }"/>
            <Button
              text="Megsem"
              type="Reject"
              press=".onConfirmCard2No"
              class="sapUiTinyMarginBegin"
              visible="{= ${noah2>/pendingConfirmation} ? true : false }"/>
          </HBox>
        </Panel>

        <Panel headerText="Router naplo" class="noahRouterPanel sapUiSmallMarginBottom" visible="{= !${noah2>/agentEnabled} }">
          <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
            <ObjectStatus text="{= 'Osszes dontes: ' + ${noah2>/routerLog}.length }" state="Information"/>
          </HBox>
          <List id="noah2RouterLogList" items="{noah2>/routerLog}" class="noahRouterList">
            <CustomListItem class="noahRouterItem">
              <VBox>
                <HBox justifyContent="SpaceBetween" alignItems="Center">
                  <Title level="H6" text="{= ${noah2>selected_card_id} ? ${noah2>selected_card_id} : 'normal-chat' }"/>
                  <ObjectStatus
                    text="{= 'konf: ' + ${noah2>confidence} }"
                    state="{= Number(${noah2>confidence}) >= 0.8 ? 'Success' : (Number(${noah2>confidence}) >= 0.55 ? 'Warning' : 'Error') }"/>
                </HBox>
                <Text text="{noah2>rationale_short}" wrapping="true"/>
                <Text text="{noah2>timestamp}" class="sapUiTinyMarginTop noahRouterTimestamp"/>
              </VBox>
            </CustomListItem>
          </List>
        </Panel>

        <Panel headerText="Agent mode - Lepesenkenti terv" class="noahRouterPanel" visible="{noah2>/agentEnabled}">
          <VBox>
            <ObjectStatus
              text="{= ${noah2>/agentApprovalPending} ? 'Terv jovahagyasra var - futtasd lepesenkent' : (${noah2>/agentBusy} ? 'Reasoning folyamatban...' : 'Varakozik problemara') }"
              state="{= ${noah2>/agentApprovalPending} ? 'Warning' : (${noah2>/agentBusy} ? 'Information' : 'Success') }"
              class="sapUiTinyMarginBottom"/>
            <Text
              text="{= ${noah2>/agentPlan/summary} ? ${noah2>/agentPlan/summary} : 'Agent modban a problemamegoldasi terv itt jelenik meg lepesenkenti futtatasi lehetoseggel.' }"
              wrapping="true"
              class="sapUiTinyMarginBottom"/>
            <Panel
              headerText="Reasoning / terv"
              expandable="true"
              expanded="true"
              class="sapUiTinyMarginBottom"
              visible="{= ${noah2>/agentPlan} ? true : false }">
              <Text text="{noah2>/agentPlan/reasoning}" wrapping="true"/>
            </Panel>
            <List
              items="{noah2>/agentPlan/steps}"
              visible="{= ${noah2>/agentPlan} ? true : false }"
              showSeparators="Inner"
              class="noahAgentList">
              <CustomListItem class="noahRouterItem">
                <VBox class="sapUiTinyMarginBegin sapUiTinyMarginEnd sapUiTinyMarginTopBottom">
                  <HBox justifyContent="SpaceBetween" alignItems="Center">
                    <Title
                      level="H6"
                      text="{= ${noah2>order} + '. ' + (${noah2>type} === 'ai-chat' ? '[AI Chat] ' : '') + ${noah2>card_name} }"/>
                    <ObjectStatus
                      text="{= ${noah2>_status} === 'done' ? 'Kesz' : (${noah2>_status} === 'running' ? 'Fut...' : (${noah2>missing_required_fields} &amp;&amp; ${noah2>missing_required_fields}.length > 0 ? 'Input hianyzik' : 'Var')) }"
                      state="{= ${noah2>_status} === 'done' ? 'Success' : (${noah2>_status} === 'running' ? 'Information' : (${noah2>missing_required_fields} &amp;&amp; ${noah2>missing_required_fields}.length > 0 ? 'Warning' : 'None')) }"/>
                  </HBox>
                  <Text text="{noah2>rationale}" wrapping="true" class="sapUiTinyMarginBottom"/>
                  <List items="{noah2>planned_inputs}" showSeparators="None" visible="{= ${noah2>planned_inputs} &amp;&amp; ${noah2>planned_inputs}.length > 0 }">
                    <CustomListItem>
                      <Text
                        text="{= ${noah2>label} + ' [' + ${noah2>source} + ']' + (${noah2>value_preview} ? ': ' + ${noah2>value_preview} : '') }"
                        wrapping="true"/>
                    </CustomListItem>
                  </List>
                  <Button
                    text="{= ${noah2>_status} === 'done' ? 'Kesz' : 'Futtatas' }"
                    type="{= ${noah2>_status} === 'done' ? 'Accept' : 'Emphasized' }"
                    press=".onRunAgentStep"
                    class="sapUiTinyMarginTop"
                    enabled="{= !!${noah2>_canRunNow} &amp;&amp; !${noah2>/agentBusy} }"/>
                </VBox>
              </CustomListItem>
            </List>
          </VBox>
        </Panel>

        <MessageStrip
          visible="{= ${noah2>/error} ? true : false }"
          text="{noah2>/error}"
          type="Error"
          showIcon="true"
          class="sapUiSmallMarginTop"/>
      </VBox>
    </HBox>
  </Page>
</mvc:View>
